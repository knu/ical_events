CONFIG_FILE = File.expand_path("~/.config/ical_events.yaml")

RE_URL = %r{\bhttps?://[^"<>\s]+}

BULLET = "\u2022"

TIME_FORMAT = "%Y/%m/%d %H:%M %z"

def load_configuration(file = CONFIG_FILE)
  if File.exist?(file)
    YAML.load_file(file, symbolize_names: true)
  else
    {}
  end
end

def edit_configuration(file = CONFIG_FILE)
  if !File.exist?(file)
    require "fileutils"
    FileUtils.mkdir_p(File.dirname(file))
    File.write(file, <<-'EOF')
# Calendars to check
calendars:
# - Personal
# - type: regexp
#   pattern: |-
#     ^(?i:me@)
urls:
  # URLs to ignore
  ignore:
    # Example: Ignore URLs of developer only meetings because I'm not a developer.
    # - calendar: me@my.compan.y
    #   title:
    #     type: regexp
    #     pattern: |-
    #       (?i:Developers Only)
    # Example: Do not open Google Meet URLs because we don't use Google Meet in this community.
    # - calendar: me@my.communit.y
    #   url:
    #     type: regexp
    #     pattern: |-
    #       ^https://meet\.google\.com/
  account:
    # Open Google URLs with an authuser parameter.
    google:
      # Example: Open Google Links as their respective organization selves.
      # me@my.compan.y:
      #   - calendar: me@my.compan.y
      # me@my.communit.y:
      #   - calendar: me@my.communit.y
    zoom:
    # Open Zoom URLs using a specific name.
      # Example: Include my company name when joining a Zoom meeting with external attendees.
      # "Me (My Company)":
      #   - calendar: me@my.compan.y
      #     attendee:
      #       type: regexp
      #       pattern: |-
      #         \S@(?=\S)(?~@my\.compan\.y)$
  open:
    # Define how to open each URL.  First match wins.
    #
    # Open URLs from company calendars with Chrome using the second profile.
    # - with: |-
    #     /Applications/Google\ Chrome.app/Contents/MacOS/Google\ Chrome --profile-directory='Profile 1' -g %s
    #   if:
    #     - calendar: me@my.compan.y
    #       url:
    #         type: regexp
    #         pattern: |-
    #           ^https?://
    # This is the default.
    # - with: |-
    #     open -g %s
    EOF
  end

  system(
    ENV.fetch("EDITOR") { "/usr/bin/vi" },
    file
  )
end

def configuration
  @configuration ||= load_configuration()
end

def pattern_to_regexp(value)
  case value
  in nil
    //
  in String
    /\A#{Regexp.quote(value)}\z/
  in { type: "regexp", pattern: }
    Regexp.new(pattern)
  in { type: }
    raise "Unsupported type: #{type}"
  else
    raise "Unsupported pattern: #{value.inspect}"
  end
end

def compile_event_pattern(hash)
  hash.transform_values { |value|
    pattern_to_regexp(value)
  }
end

class JsonStruct < Struct
  def as_json
    to_h.transform_values { |v|
      case v
      when Time, Date
        v.iso8601
      else
        v
      end
    }
  end

  def to_json(*a)
    as_json.to_json(*a)
  end
end

class Calendar < JsonStruct.new(
  :title,
  :type,
  :uid,
  keyword_init: true
)
end

class Event < JsonStruct.new(
  :title,
  :calendar,
  :start_at,
  :start_on,
  :end_at,
  :end_on,
  :attendees,
  :location,
  :notes,
  :url,
  :urls,
  keyword_init: true
)
  def start_in_range?(range)
    if start_at
      range.cover?(start_at)
    else
      false
    end
  end
end

class Reminder < JsonStruct.new(
  :title,
  :list,
  :calendar,
  :completed,
  :due_at,
  :due_on,
  :remind_at,
  :priority,
  :attendees,
  :location,
  :notes,
  :url,
  :urls,
  :id,
  keyword_init: true
)
end

def event_match?(event, hash)
  if hash in { calendar: }
    calendar === event.calendar or return false
  end

  if hash in { title: }
    title === event.title or return false
  end

  if hash in { location: }
    location === event.location or return false
  end

  if hash in { notes: }
    notes === event.notes or return false
  end

  if hash in { url: }
    Array(event.urls).any?(url) or return false
  end

  if hash in { attendee: }
    Array(event.attendees).any?(attendee) or return false
  end

  true
end

def get_calendars
  IO.popen(%W[icalBuddy calendars]) do |io|
    calendars = []
    calendar = nil

    io.each_line(chomp: true) { |line|
      case line
      when /\A#{BULLET} \K(.+)/o
        calendar = Calendar.new(title: $1)
        calendars << calendar
      when /\A  type: \K(.+)/
        calendar.type = $1
      when /\A  UID: \K(.+)/
        calendar.uid = $1
      end
    }

    calendars
  end
end

def get_events(calendars, argv, &event_in_range_p)
  events = []

  IO.popen(
    %W[
      icalBuddy -ic #{calendars.map(&:uid).join(',')} -nrd -df %Y-%m-%d -tf %Y-%m-%dT%H:%M:%S%z
    ] + argv
  ) do |io|
    event = nil
    last_prop = nil

    io.each_line(chomp: true) do |line|
      case line
      when /\A#{Regexp.quote(BULLET)} (.+) \((#{Regexp.union(calendars.map(&:title))})\)\z/o
        events << event if event && event_in_range_p.call(event)
        event = Event.new(title: $1, calendar: $2)
      when /\A    (\w+): (.+)/
        last_prop = $1.to_sym
        event[last_prop] = $2
      when /\A    ( .+)/
        event[last_prop] << "\n" << $1.delete_prefix(' ' * (last_prop.size + 2))
      when /\A    (\d{4}-\d{2}-\d{2}.*)/
        start_at, end_at = $1.split(' - ').map { |timespec|
          case timespec
          when /(\d{4}-\d{2}-\d{2}T\S+)/
            Time.parse($1)
          when /(\d{4}-\d{2}-\d{2})/
            Date.parse($1)
          end
        }
        end_at ||= start_at

        case start_at
        when Date
          event[:start_on] = start_at
        when Time
          event[:start_at] = start_at
          event[:start_on] = start_at.to_date
        else
          $stderr.puts "invalid date/time range: #{line}"
        end

        case end_at
        when Date
          event[:end_on] = end_at
        when Time
          event[:end_at] = end_at
          event[:end_on] = end_at.to_date
        else
          $stderr.puts "invalid date/time range: #{line}"
        end
      end
    end
    events << event if event && event_in_range_p.call(event)
  end

  events
end

REMINDERS_SWIFT = <<~'SWIFT'
import Dispatch
import EventKit
import Foundation

let store = EKEventStore()
let accessSemaphore = DispatchSemaphore(value: 0)
var granted = false

if #available(macOS 14.0, *) {
  store.requestFullAccessToReminders { ok, _ in
    granted = ok
    accessSemaphore.signal()
  }
} else {
  store.requestAccess(to: .reminder) { ok, _ in
    granted = ok
    accessSemaphore.signal()
  }
}
accessSemaphore.wait()

if !granted {
  fputs("reminders access denied\n", stderr)
  exit(1)
}

let formatter = ISO8601DateFormatter()

func iso8601(_ date: Date?) -> Any {
  guard let date else { return NSNull() }
  return formatter.string(from: date)
}

func value(_ string: String?) -> Any {
  string ?? ""
}

let predicate = store.predicateForReminders(in: nil)
let fetchSemaphore = DispatchSemaphore(value: 0)
var rows: [[String: Any]] = []

store.fetchReminders(matching: predicate) { reminders in
  rows = (reminders ?? []).filter { !$0.isCompleted }.map { reminder in
    let dueDate = reminder.dueDateComponents?.date
    let remindDate = reminder.alarms?.compactMap(\.absoluteDate).min()

    return [
      "title": value(reminder.title),
      "list": value(reminder.calendar.title),
      "calendar": value(reminder.calendar.title),
      "completed": reminder.isCompleted,
      "due_at": iso8601(dueDate),
      "remind_at": iso8601(remindDate),
      "priority": reminder.priority,
      "notes": value(reminder.notes),
      "url": reminder.url?.absoluteString ?? "",
      "urls": [],
      "id": reminder.calendarItemIdentifier,
    ]
  }
  fetchSemaphore.signal()
}
fetchSemaphore.wait()

let data = try JSONSerialization.data(withJSONObject: rows, options: [])
print(String(data: data, encoding: .utf8)!)
SWIFT

def get_reminders
  json, err, status = Open3.capture3("swift", "-e", REMINDERS_SWIFT)
  status.success? or abort err

  reminders = JSON.parse(json, symbolize_names: true).map { |hash|
    due_at = Time.parse(hash[:due_at]) if hash[:due_at]
    remind_at = Time.parse(hash[:remind_at]) if hash[:remind_at]

    Reminder.new(
      title: hash[:title],
      list: hash[:list],
      calendar: hash[:calendar],
      completed: hash[:completed],
      due_at: due_at,
      due_on: due_at&.to_date,
      remind_at: remind_at,
      priority: hash[:priority],
      attendees: nil,
      location: nil,
      notes: hash[:notes],
      url: hash[:url],
      urls: hash[:urls],
      id: hash[:id]
    )
  }

  add_reminder_urls_from_store(reminders)
  reminders
end

def add_reminder_urls_from_store(reminders)
  ids = reminders.map { |reminder| reminder.id.delete("-").upcase }
  urls_by_id = reminder_urls_from_store(ids)

  reminders.each do |reminder|
    urls = urls_by_id[reminder.id.delete("-").upcase] || []
    reminder[:url] = urls.first || (reminder.url unless reminder.url&.empty?)
    reminder[:urls] = [*reminder.urls, *urls].uniq
  end
end

def reminder_urls_from_store(ids)
  return {} if ids.empty?

  store_dir = File.expand_path("~/Library/Group Containers/group.com.apple.reminders/Container_v1/Stores")
  stores = reminder_store_paths(store_dir)
  if stores.empty?
    $stderr.puts "No Reminders store files were found in #{store_dir}."
    return {}
  end

  quoted_ids = ids.map { |id| "'#{id}'" }.join(",")
  query = <<~SQL
    select upper(hex(r.ZIDENTIFIER)), coalesce(r.ZICSURL, ''), coalesce(o.ZURL, '')
    from ZREMCDREMINDER r
    left join ZREMCDOBJECT o
      on o.ZREMINDER = r.Z_PK
      or o.ZREMINDER1 = r.Z_PK
      or o.ZREMINDER2 = r.Z_PK
      or o.ZREMINDER3 = r.Z_PK
      or o.ZREMINDER4 = r.Z_PK
      or o.ZREMINDER5 = r.Z_PK
    where r.ZCOMPLETED = 0
      and upper(hex(r.ZIDENTIFIER)) in (#{quoted_ids})
  SQL
  urls_by_id = Hash.new { |hash, key| hash[key] = [] }

  stores.each do |db|
    output, err, status = Open3.capture3(
      "sqlite3",
      "-separator", "\x1f",
      "-newline", "\x1e",
      db,
      query
    )
    unless status.success?
      $stderr.puts err
      request_full_disk_access("sqlite3 failed while reading the Reminders store.")
      return urls_by_id.transform_values!(&:uniq)
    end

    output.split("\x1e").each do |line|
      id, *urls = line.split("\x1f", -1)
      next if id.nil? || id.empty?

      urls_by_id[id].concat(urls.grep(RE_URL))
    end
  rescue Errno::ENOENT
    break
  end

  urls_by_id.transform_values!(&:uniq)
rescue Errno::EPERM => e
  request_full_disk_access("EPERM while listing the Reminders store: #{e.message}")
  {}
end

def reminder_store_paths(store_dir)
  Dir.glob("#{store_dir}/Data-*.sqlite")
end

def request_full_disk_access(reason)
  message = [
    reason,
    "Grant Full Disk Access to the app running #{File.basename($0)}.",
  ].join("\n")
  $stderr.puts message
  show_full_disk_access_alert(message)
  open_full_disk_access_settings
end

def show_full_disk_access_alert(message)
  system(
    "osascript",
    "-e",
    "display alert #{message.dump} as warning buttons {\"OK\"} default button \"OK\""
  )
end

def open_full_disk_access_settings
  system("open", "x-apple.systempreferences:com.apple.preference.security?Privacy_AllFiles")
end

def get_opener_func
  opener_funcs = Array(configuration[:open]).map { |open_hash|
    open_hash => with: command_template

    if open_hash in if: if_hashes
      patterns = Array(if_hashes).map { |if_hash|
        compile_event_pattern(if_hash)
      }

      ->(url, event) {
        command_template if patterns.any? { |hash|
          case hash
          in { url: url_pattern, **rest }
            url_pattern === url && event_match?(event, rest)
          else
            event_match?(event, hash)
          end
        }
      }
    else
      ->(url, event) { command_template }
    end
  }

  ->(url, event) {
    opener_funcs.each do |func|
      if command_template = func.call(url, event)
        return command_template
      end
    end
    'open -g %s'
  }
end

def require_icalbuddy(myname)
  Process.wait2(spawn("type icalBuddy", err: IO::NULL, out: IO::NULL))[1].success? or
    abort "#{myname}: icalBuddy must be installed.  To install it via Homebrew, run `brew install ical-buddy`."
end

def urls_configuration
  urls_ignore = Array(configuration.dig(:urls, :ignore)).map { |hash|
    compile_event_pattern(hash)
  }

  urls_account = configuration.dig(:urls, :account)&.then { |account_hash|
    account_hash.transform_values { |account_to_patterns|
      account_to_patterns.to_h { |account, patterns|
        [
          account.to_s,
          patterns.map { |hash|
            compile_event_pattern(hash)
          }
        ]
      }
    }
  } || {}

  [urls_ignore, urls_account]
end

def add_urls(events, urls_ignore, urls_account)
  account_for_event = -> (event, account_type) {
    urls_account[account_type]&.each_pair do |account, patterns|
      if patterns.any? { |pattern| event_match?(event, pattern) }
        return account
      end
    end

    nil
  }

  events.each do |event|
    event[:attendees] &&= event[:attendees].split(', ') if event[:attendees].is_a?(String)

    urls = [
      *event[:url]&.scan(RE_URL),
      *event[:title]&.scan(RE_URL),
      *event[:location]&.scan(RE_URL),
      *event[:notes]&.scan(RE_URL),
      *event[:urls],
    ].reject { |url|
      urls_ignore.any? { |hash|
        case hash
        in { url: url_pattern, **rest }
          url_pattern === url && event_match?(event, rest)
        else
          event_match?(event, hash)
        end
      }
    }

    meeting_uris, other_uris = urls.map { |url| URI(url) }.group_by { |uri|
      case uri.host
      when /(?:\A|\.)zoom\.us\z/
        :meeting
      when 'meet.google.com'
        :meeting
      when 'tel.meet'
        nil
      when 'www.getclockwise.com'
        nil
      when 'whereby.com'
        :meeting
      when /\.slack\.com\z/
        case uri.path
        when %r{\A/team/}
          # Slack @user/@team mentions
          nil
        else
          :other
        end
      else
        :other
      end
    }.values_at(:meeting, :other).map { |uris|
      Array(uris).map { |uri|
        case uri.host
        when /\.google\.com\z/
          if account = account_for_event.call(event, :google)
            uri + "?#{uri.query&.+ "&"}#{URI.encode_www_form(authuser: account)}"
          else
            uri
          end
        when /(?:\A|\.)zoom\.us\z/
          case uri.path
          when %r{\A/j/(\d+)\z}
            confno = $1
            if username = account_for_event.call(event, :zoom)
              URI("zoommtg://zoom.us/join?#{URI.encode_www_form(confno: confno, uname: username)}&#{uri.query}")
            else
              uri
            end
          when %r{\A/s/(\d+)\z}
            confno = $1
            if username = account_for_event.call(event, :zoom)
              URI("zoommtg://zoom.us/start?#{URI.encode_www_form(confno: confno, uname: username)}&#{uri.query}")
            else
              uri
            end
          else
            uri
          end
        else
          uri
        end
      }
    }

    meeting_uri = meeting_uris.max_by { |uri|
      case uri.host
      when /(?:\A|\.)zoom\.us\z/
        case uri.path
        when %r{\A/(?:j|s|(?:wc/)?(?:join|start))(?:/|\z)}
          if /pwd=/.match?(uri.query)
            10
          else
            9
          end
        else
          1
        end
      when 'meet.google.com'
        case uri.path
        when %r{\A/[a-z]{3,}(?:-[a-z]{3,}){2,}\z}
          9
        else
          1
        end
      when 'whereby.com'
        case uri.path
        when %r{\A/[^/]+\z}
          9
        else
          1
        end
      else
        0
      end
    }

    event[:urls] = [*meeting_uri, *other_uris].uniq.map(&:to_s)
  end
end

def open_event_urls(events)
  opener = get_opener_func

  events.each do |event|
    event[:urls].each do |url|
      system(opener.call(url, event) % url.shellescape)
    end
  end
end

def main
  start_at_range = nil

  myname = File.basename($0)

  if ARGV.delete("-V")
    system("icalBuddy -V")
    exit
  end

  # JSON is our output format and fancy output breaks parsing.
  ARGV.delete("-f")

  # These flags are ours, not icalBuddy's, so accept them anywhere.
  open_urls = !ARGV.delete("--open-urls").nil?
  verbose = !ARGV.delete("--verbose").nil?

  until ARGV.empty?
    case ARGV.first
    when '--edit-config'
      edit_configuration
      exit
    when '--help'
      stdout, stderr, = Open3.capture3("icalBuddy", "--help")
      help = stdout + stderr
      if help.empty?
        puts <<~EOS
        USAGE: #{myname} [options] [<command>] [icalBuddy options]

        ical_events specific [options] (--open-urls and --verbose may appear anywhere):

        --edit-config
                    Edit the configuration file, creating one if not
        --open-urls Open URLs in matching events via open(1)
        --verbose   Print additional information to stderr

        Commands:

          eventsNow
                     Print current events (default)
          eventsInMinutes:NUM
                     Print events occurring in N minutes
          reminders
                     Print incomplete reminders containing URLs
        EOS
        exit
      end
      help.sub!(/^USAGE: \KicalBuddy/, myname)
      help.sub!(/^<command>.*$/) { $& + " (default: eventsNow)" }
      help.sub!(/^( +'eventsNow'\s+.*\n)/) { $& + <<-EOS }
  'eventsInMinutes:NUM'
                     Print events occurring in N minutes (#{myname} feature)
  'reminders'
                     Print incomplete reminders containing URLs (#{myname} feature)
        EOS
      help.sub!(/^Some .*\n/, <<-EOS)
ical_events specific [options] (--open-urls and --verbose may appear anywhere):

--edit-config
            Edit the configuration file, creating one if not
--open-urls Open URLs in matching events via open(1)
--verbose   Print additional information to stderr

followed by icalBuddy options:
        EOS
      help.sub!(/^-[A-Za-z].*\n\n/) { $& + <<-EOS }
#{myname} prints out events in JSON, so among others, formatting options do not work with ical_events.

        EOS
      print help
      exit
    when 'calendars'
      require_icalbuddy(myname)
      puts JSON.pretty_generate(get_calendars)
      exit
    when 'reminders'
      ARGV.shift
      urls_ignore, urls_account = urls_configuration
      reminders = get_reminders
      add_urls(reminders, urls_ignore, urls_account)
      open_event_urls(reminders) if open_urls
      puts JSON.pretty_generate(reminders)
      exit
    else
      break
    end

    ARGV.shift
  end

  argv =
    if ARGV.empty?
      %w[eventsNow]
    else
      ARGV.flat_map { |arg|
        case arg
        when /\AeventsInMinutes:(-?\d+)\z/
          now = Time.now
          minutes = $1.to_i
          from, to = [now, now + minutes * 60].sort
          start_at_range = from...to
          [
            "eventsFrom:" + from.strftime(TIME_FORMAT),
            "to:" + to.strftime(TIME_FORMAT),
          ]
        else
          arg
        end
      }
    end

  urls_ignore, urls_account = urls_configuration

  require_icalbuddy(myname)

  re_calendar_name =
    if (patterns = Array(configuration.dig(:calendars))).size > 0
      Regexp.union(patterns.map { |pattern|
        pattern_to_regexp(pattern)
      })
    else
      //
    end

  calendars = get_calendars.select { |calendar|
    re_calendar_name.match?(calendar.title)
  }

  if verbose
    $stderr.puts "Checking #{calendars.size} calendars:"
    calendars.each do |calendar|
      $stderr.puts "- #{calendar.title}"
    end
  end

  events = get_events(calendars, argv) { |event|
    if start_at_range
      event.start_in_range?(start_at_range)
    else
      true
    end
  }

  add_urls(events, urls_ignore, urls_account)
  open_event_urls(events) if open_urls

  puts JSON.pretty_generate(events)
end

main
